
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EduPath TKA - Academic Intelligence</title>

<style>
:root {
  --navy: #071a35;
  --navy2: #0d2850;
  --blue: #2563eb;
  --blue2: #1d4ed8;
  --cyan: #38bdf8;
  --bg: #f1f6ff;
  --white: #ffffff;
  --text: #10213d;
  --muted: #64748b;
  --border: #dbeafe;
  --green: #10b981;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', sans-serif;
}

body {
  background:
    radial-gradient(circle at 10% 10%, #dbeafe 0, transparent 30%),
    radial-gradient(circle at 90% 60%, #cffafe 0, transparent 25%),
    var(--bg);
  color: var(--text);
  line-height: 1.6;
}

.container {
  max-width: 1150px;
  margin: auto;
  padding: 0 20px;
}

.hidden {
  display: none !important;
}

/* NAVBAR */

.navbar {
  background: rgba(7,26,53,.97);
  border-bottom: 1px solid rgba(56,189,248,.3);
  padding: 16px 0;
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(15px);
  box-shadow: 0 5px 25px rgba(7,26,53,.15);
}

.nav-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  color: white;
  font-size: 1.55rem;
  font-weight: 850;
  letter-spacing: -1px;
}

.logo span {
  color: var(--cyan);
}

.creator-badge {
  font-size: .82rem;
  color: #7dd3fc;
  background: rgba(56,189,248,.12);
  border: 1px solid rgba(56,189,248,.3);
  padding: 7px 14px;
  border-radius: 30px;
}

/* HERO */

.hero {
  text-align: center;
  padding: 65px 10px 40px;
}

.hero-label {
  display: inline-block;
  color: var(--blue);
  background: #dbeafe;
  padding: 6px 15px;
  border-radius: 30px;
  font-size: .78rem;
  font-weight: 800;
  letter-spacing: 1px;
  margin-bottom: 15px;
}

.hero h1 {
  font-size: clamp(2rem,5vw,3rem);
  line-height: 1.2;
  font-weight: 850;
  letter-spacing: -1.5px;
  background: linear-gradient(90deg,#0b1b35,#2563eb,#06b6d4);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
  margin-bottom: 15px;
}

.hero p {
  max-width: 720px;
  margin: auto;
  color: var(--muted);
}

/* CARDS */

.card {
  background: rgba(255,255,255,.96);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 27px;
  margin-bottom: 25px;
  box-shadow: 0 8px 30px rgba(37,99,235,.06);
}

.card h2 {
  color: var(--navy2);
  font-size: 1.25rem;
  margin-bottom: 10px;
}

.section-description {
  color: var(--muted);
  font-size: .9rem;
  margin-bottom: 22px;
}

/* INPUT */

.input-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
  gap: 20px;
  margin: 22px 0;
}

.input-group {
  display: flex;
  flex-direction: column;
}

.input-group label {
  font-weight: 700;
  margin-bottom: 7px;
  color: var(--navy2);
}

.input-group input {
  width: 100%;
  padding: 13px;
  background: #f8fbff;
  border: 1px solid #cbdcf5;
  border-radius: 10px;
  font-size: 1rem;
  outline: none;
  transition: .25s;
}

.input-group input:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 4px rgba(37,99,235,.12);
  background: white;
}

.input-group small {
  color: var(--muted);
  font-size: .78rem;
  margin-top: 6px;
}

.example-note {
  background: #eff6ff;
  border-left: 4px solid var(--cyan);
  padding: 13px 15px;
  border-radius: 8px;
  font-size: .85rem;
  color: #1e40af;
  margin-bottom: 20px;
}

/* BUTTONS */

.button-group {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

button {
  cursor: pointer;
  border: none;
  padding: 12px 19px;
  border-radius: 10px;
  font-weight: 700;
  font-size: .9rem;
  transition: .25s;
}

.btn-primary {
  color: white;
  background: linear-gradient(135deg,var(--blue),#0891b2);
  box-shadow: 0 5px 15px rgba(37,99,235,.2);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(37,99,235,.3);
}

.btn-secondary {
  color: var(--blue);
  background: #e8f1ff;
  border: 1px solid #bfdbfe;
}

.btn-secondary:hover {
  background: #dbeafe;
}

/* STATISTICS */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(190px,1fr));
  gap: 15px;
  margin: 22px 0;
}

.stat-box {
  padding: 19px;
  background: linear-gradient(145deg,#eff6ff,#fff);
  border: 1px solid var(--border);
  border-radius: 13px;
}

.stat-label {
  display: block;
  color: var(--muted);
  font-size: .82rem;
  margin-bottom: 5px;
}

.stat-value {
  color: var(--blue);
  font-weight: 800;
  font-size: 1.2rem;
}

.bar-item {
  margin-bottom: 15px;
}

.bar-header {
  display: flex;
  justify-content: space-between;
  font-size: .9rem;
  font-weight: 700;
  margin-bottom: 6px;
}

.bar-track {
  height: 11px;
  background: #dbeafe;
  border-radius: 20px;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg,#2563eb,#06b6d4);
  border-radius: 20px;
  transition: width .6s;
}

/* SECTION HEADER */

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  flex-wrap: wrap;
  gap: 15px;
  margin: 35px 0 18px;
}

.section-header h2 {
  color: var(--navy2);
  font-size: 1.3rem;
}

.section-header p {
  color: var(--muted);
  font-size: .85rem;
}

/* FILTER */

.filter-group {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.filter-btn {
  background: white;
  color: var(--muted);
  border: 1px solid var(--border);
  padding: 8px 13px;
  font-size: .8rem;
  border-radius: 30px;
}

.filter-btn.active {
  background: var(--blue);
  color: white;
  border-color: var(--blue);
}

/* MAJOR CARDS */

.majors-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill,minmax(300px,1fr));
  gap: 19px;
  margin-bottom: 30px;
}

.major-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 21px;
  display: flex;
  flex-direction: column;
  transition: .3s;
}

.major-card:hover {
  transform: translateY(-5px);
  border-color: #60a5fa;
  box-shadow: 0 12px 28px rgba(37,99,235,.12);
}

.major-card.top-match {
  border: 2px solid var(--cyan);
  background: linear-gradient(145deg,#effaff,#fff);
}

.badge-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 14px;
}

.match-badge {
  background: linear-gradient(135deg,#2563eb,#0891b2);
  color: white;
  padding: 5px 11px;
  border-radius: 20px;
  font-size: .76rem;
  font-weight: 800;
}

.top-match .match-badge {
  background: linear-gradient(135deg,#0891b2,#10b981);
}

.category-tag {
  background: #eff6ff;
  color: #1d4ed8;
  border: 1px solid #dbeafe;
  padding: 4px 8px;
  border-radius: 6px;
  font-size: .7rem;
}

.rank-number {
  color: #93c5fd;
  font-size: 2rem;
  font-weight: 900;
  line-height: 1;
}

.major-card h3 {
  font-size: 1.1rem;
  color: var(--navy2);
  line-height: 1.4;
  margin: 8px 0;
}

.major-desc {
  color: var(--muted);
  font-size: .85rem;
  margin-bottom: 15px;
}

.match-progress {
  margin: 8px 0 17px;
}

.match-progress-header {
  display: flex;
  justify-content: space-between;
  font-size: .8rem;
  font-weight: 700;
  margin-bottom: 6px;
}

.match-track {
  height: 9px;
  background: #e2e8f0;
  border-radius: 20px;
  overflow: hidden;
}

.match-fill {
  height: 100%;
  background: linear-gradient(90deg,#2563eb,#06b6d4);
  border-radius: 20px;
}

.weight-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 15px;
}

.weight-pill {
  background: #eff6ff;
  color: #1e40af;
  padding: 4px 8px;
  border-radius: 6px;
  font-size: .7rem;
  font-weight: 700;
}

.major-details {
  border-top: 1px solid var(--border);
  padding-top: 13px;
  margin-top: auto;
  font-size: .82rem;
  color: var(--muted);
}

.major-details p {
  margin-bottom: 8px;
}

.major-details strong {
  color: var(--navy2);
}

/* ROADMAP */

.subtitle {
  color: var(--muted);
  font-size: .9rem;
  margin-bottom: 20px;
}

.tka-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(230px,1fr));
  gap: 15px;
}

.tka-item {
  padding: 18px;
  background: linear-gradient(145deg,#f8fbff,#eff6ff);
  border: 1px solid var(--border);
  border-radius: 13px;
}

.tka-item.priority-high {
  border-left: 4px solid var(--blue);
}

.tka-tag {
  color: var(--blue);
  font-weight: 800;
  font-size: .75rem;
}

.tka-item h4 {
  color: var(--navy2);
  margin: 8px 0 12px;
}

.tka-item ul {
  padding-left: 18px;
  color: var(--muted);
  font-size: .82rem;
}

.tka-item li {
  margin-bottom: 8px;
}

/* FOOTER */

footer {
  background: var(--navy);
  color: #94a3b8;
  text-align: center;
  padding: 27px 15px;
  margin-top: 45px;
  border-top: 2px solid var(--blue);
  font-size: .85rem;
}

footer strong {
  color: var(--cyan);
}

/* RESPONSIVE */

@media(max-width:600px) {
  .hero {
    padding: 45px 10px 30px;
  }

  .card {
    padding: 19px;
  }

  .majors-grid {
    grid-template-columns: 1fr;
  }

  .button-group button {
    width: 100%;
  }

  .creator-badge {
    font-size: .7rem;
    padding: 6px 9px;
  }

  .section-header {
    align-items: flex-start;
  }
}
</style>
</head>

