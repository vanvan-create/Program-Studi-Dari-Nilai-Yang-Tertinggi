    </div>

    <div class="button-group">
      <button type="submit" class="btn-primary">
        ✦ Analisis Potensi Akademik
      </button>

      <button type="button" id="sampleBtn" class="btn-secondary">
        Isi Contoh Nilai
      </button>

      <button type="button" id="resetBtn" class="btn-secondary">
        Reset
      </button>
    </div>

  </form>
</section>

<section id="resultSection" class="hidden">

  <div class="card">

    <h2>02. Profil Akademik Anda</h2>
    <p class="section-description">
      Ringkasan performa akademik berdasarkan nilai yang dimasukkan.
    </p>

    <div class="stats-grid">

      <div class="stat-box">
        <span class="stat-label">Rata-Rata Nilai</span>
        <span class="stat-value" id="avgScore">0</span>
      </div>

      <div class="stat-box">
        <span class="stat-label">Mata Pelajaran Terkuat</span>
        <span class="stat-value" id="topSubject">-</span>
      </div>

      <div class="stat-box">
        <span class="stat-label">Kategori Potensi</span>
        <span class="stat-value" id="clusterType">-</span>
      </div>

    </div>

    <h3 style="font-size:1rem;margin-bottom:15px;color:#123b70">
      Distribusi Nilai Akademik
    </h3>

    <div id="subjectBars"></div>

  </div>

  <div class="section-header">

    <div>
      <h2>03. Rekomendasi Program Studi</h2>
      <p>
        <span id="totalMajorsCount">0</span> program studi
        diurutkan berdasarkan skor kecocokan.
      </p>
    </div>

    <div class="filter-group" id="filterButtons">
      <button class="filter-btn active" data-filter="all">Semua</button>
      <button class="filter-btn" data-filter="Komputasi & Data">Komputasi</button>
      <button class="filter-btn" data-filter="Teknik & Rekayasa">Teknik</button>
      <button class="filter-btn" data-filter="Sains & Kimia">Sains</button>
    </div>

  </div>

  <div id="majorsContainer" class="majors-grid"></div>

  <div class="card">
    <h2>04. Academic Learning Roadmap</h2>

    <p class="subtitle">
      Rekomendasi materi pembelajaran berdasarkan
      urutan kekuatan nilai akademik Anda.
    </p>

    <div id="tkaRoadmap" class="tka-grid"></div>
  </div>

</section>

</main>

<footer>
  <div class="container">
    <p>© 2026 EduPath TKA. Designed & Developed by
      <strong>Evan</strong>.
    </p>
    <p style="margin-top:5px">
      Empowering Your Academic Future Through Data & Technology.
    </p>
  </div>
</footer>

