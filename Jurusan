category:"Sains & Kimia",
weights:{matematika:.15,fisika:.10,kimia:.65,informatika:.10},
description:"Mempelajari formulasi obat, senyawa aktif, kimia medisinal, dan penelitian biomedis.",
courses:"Kimia Medisinal, Farmasetika, Farmakologi.",
career:"Apoteker, Researcher, Quality Assurance.",
tkaFocus:["Senyawa Karbon dan Stoikiometri","Logaritma & Konsentrasi"]
}

];

const tkaMaterials = {

matematika:{
title:"Matematika",
topics:[
"Aljabar: Persamaan kuadrat, eksponen, logaritma, fungsi.",
"Kalkulus: Limit, turunan, dan integral.",
"Geometri: Trigonometri, dimensi tiga, dan vektor.",
"Statistika: Permutasi, kombinasi, dan peluang."
]},

fisika:{
title:"Fisika",
topics:[
"Mekanika: Kinematika, Hukum Newton, usaha dan energi.",
"Fluida & Kalor: Fluida statis, dinamis, dan termodinamika.",
"Listrik & Magnet: Rangkaian listrik dan elektromagnetik.",
"Gelombang & Optik: Gelombang mekanik dan cahaya."
]},

kimia:{
title:"Kimia",
topics:[
"Kimia Dasar: Struktur atom, ikatan, dan stoikiometri.",
"Termokimia: Energetika dan laju reaksi.",
"Larutan: Asam-basa, buffer, hidrolisis, dan Ksp.",
"Redoks: Elektrokimia dan kimia organik."
]},

informatika:{
title:"Informatika",
topics:[
"Berpikir Komputasional: Dekomposisi dan pengenalan pola.",
"Struktur Data: Array, queue, stack, dan graf.",
"Logika Boolean: Gerbang logika dan tabel kebenaran.",
"Algoritma: Penelusuran algoritma dan efisiensi."
]}

};

const subjectNames={
matematika:"Matematika",
fisika:"Fisika",
kimia:"Kimia",
informatika:"Informatika"
};

let currentRankedMajors=[];
let activeFilter="all";

/* CONTOH NILAI */

document.getElementById("sampleBtn").addEventListener("click",function(){

const sample={
matematika:88.5,
fisika:85,
kimia:82.5,
informatika:92
};

Object.keys(sample).forEach(key=>{
document.getElementById(key).value=sample[key];
});

});

/* RESET */

document.getElementById("resetBtn").addEventListener("click",function(){

document.getElementById("gradeForm").reset();

document.getElementById("resultSection").classList.add("hidden");

currentRankedMajors=[];

});

/* SUBMIT */

document.getElementById("gradeForm").addEventListener("submit",function(e){

e.preventDefault();

const scores={};

Object.keys(subjectNames).forEach(key=>{
scores[key]=parseFloat(document.getElementById(key).value);
});

for(let key in scores){

if(!Number.isFinite(scores[key]) || scores[key]<0 || scores[key]>100){

alert("Pastikan seluruh nilai berada di antara 0 hingga 100.");

return;

}

}

analyzeResults(scores);

});

/* FILTER */

document.querySelectorAll(".filter-btn").forEach(btn=>{

btn.addEventListener("click",function(){

document.querySelectorAll(".filter-btn").forEach(b=>b.classList.remove("active"));

this.classList.add("active");

activeFilter=this.dataset.filter;

renderMajorsList();

});

});

/* ANALISIS */

function analyzeResults(scores){

const avg=Object.values(scores).reduce((a,b)=>a+b,0)/4;

const sortedSubjects=Object.keys(scores).sort((a,b)=>scores[b]-scores[a]);

const highestSub=sortedSubjects[0];

document.getElementById("avgScore").textContent=avg.toFixed(1);

document.getElementById("topSubject").textContent=
subjectNames[highestSub]+" ("+scores[highestSub]+")";

const clusters={
informatika:"Komputasi & Digital",
matematika:"Analitik & Kuantitatif",
fisika:"Rekayasa & Teknologi",
kimia:"Sains & Molekuler"
};

document.getElementById("clusterType").textContent=clusters[highestSub];

/* GRAFIK NILAI */

const bars=document.getElementById("subjectBars");

bars.innerHTML="";

sortedSubjects.forEach(sub=>{

bars.innerHTML+=`
<div class="bar-item">

<div class="bar-header">
<span>${subjectNames[sub]}</span>
<span>${scores[sub]} / 100</span>
</div>

<div class="bar-track">
<div class="bar-fill" style="width:${scores[sub]}%"></div>
</div>

</div>`;

});

/* SKOR JURUSAN */

currentRankedMajors=majorsDatabase.map(major=>{

const score=Object.keys(scores).reduce((total,key)=>{

return total+scores[key]*major.weights[key];

},0);

return {...major,matchScore:score};

}).sort((a,b)=>b.matchScore-a.matchScore);

activeFilter="all";

document.querySelectorAll(".filter-btn").forEach(b=>b.classList.remove("active"));

document.querySelector('[data-filter="all"]').classList.add("active");

renderMajorsList();

renderTkaRoadmap(sortedSubjects);

const result=document.getElementById("resultSection");

result.classList.remove("hidden");

result.scrollIntoView({behavior:"smooth"});

}

/* REKOMENDASI JURUSAN */

function renderMajorsList(){

const container=document.getElementById("majorsContainer");

container.innerHTML="";

const filtered=activeFilter==="all"
?currentRankedMajors
:currentRankedMajors.filter(m=>m.category===activeFilter);

document.getElementById("totalMajorsCount").textContent=filtered.length;

filtered.forEach(major=>{

const rank=currentRankedMajors.findIndex(m=>m.name===major.name)+1;

const top3=rank<=3;

container.innerHTML+=`

<div class="major-card ${top3?'top-match':''}">

<div>

<div class="badge-row">

<span class="match-badge">
${rank===1?'★ REKOMENDASI TERATAS':'PERINGKAT #'+rank}
</span>

<span class="category-tag">${major.category}</span>

</div>

<div class="rank-number">
#${rank.toString().padStart(2,"0")}
</div>

<h3>${major.name}</h3>

<p class="major-desc">${major.description}</p>

<div class="match-progress">

<div class="match-progress-header">
<span>Tingkat Kecocokan</span>
<span>${major.matchScore.toFixed(1)}%</span>
</div>

<div class="match-track">
<div class="match-fill"
style="width:${Math.max(0,Math.min(100,major.matchScore))}%">
</div>
</div>

</div>

<div class="weight-pills">
<span class="weight-pill">Mat ${major.weights.matematika*100}%</span>
<span class="weight-pill">Fis ${major.weights.fisika*100}%</span>
<span class="weight-pill">Kim ${major.weights.kimia*100}%</span>
<span class="weight-pill">Inf ${major.weights.informatika*100}%</span>
</div>

</div>

<div class="major-details">

<p><strong>Mata Kuliah:</strong><br>${major.courses}</p>

<p><strong>Prospek Karier:</strong><br>${major.career}</p>

<p><strong>Fokus TKA:</strong><br>${major.tkaFocus.join(", ")}</p>

</div>

</div>`;

});

}

/* ROADMAP */

function renderTkaRoadmap(sortedSubjects){

const roadmap=document.getElementById("tkaRoadmap");

roadmap.innerHTML="";

const labels=[
"PRIORITAS 01 · KEKUATAN UTAMA",
"PRIORITAS 02 · PENDUKUNG",
"PRIORITAS 03 · PENGUATAN",
"PRIORITAS 04 · EVALUASI"
];

sortedSubjects.forEach((sub,index)=>{

const material=tkaMaterials[sub];

roadmap.innerHTML+=`

<div class="tka-item ${index<2?'priority-high':''}">

<span class="tka-tag">${labels[index]}</span>

<h4>${material.title}</h4>

<ul>
${material.topics.map(topic=>`<li>${topic}</li>`).join("")}
</ul>

</div>`;

});

}

});
</script>

</body>
</html>
